# Used by docker-compose-dev.yaml. Copy to .env to run the dev stack on PostgreSQL.
# Leave these unset (or delete .env) to keep using SQLite.

# Starts the bundled postgres service (host port 5436)
COMPOSE_PROFILES=postgres

# Connection string the server uses, "postgres" is the bundled service name
DATABASE_URL=postgres://bytestash:bytestash@postgres:5432/bytestash

# Copies ./data/snippets.db into PostgreSQL on startup while PostgreSQL is still empty
MIGRATE_SQLITE_TO_POSTGRES=true
